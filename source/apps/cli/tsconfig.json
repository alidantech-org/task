{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "paths": {
      "#/*": ["./src/*"],
      "@task/workspace": ["../../packages/workspace/src/index.ts"],
      "@task/workspace/*": ["../../packages/workspace/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
