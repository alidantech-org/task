{
  "name": "taskcode",
  "private": false,
  "version": "0.1.4",
  "type": "module",
  "bin": {
    "taskcode": "dist/cli.js",
    "task": "dist/cli.js",
    "tc": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:watch": "bun run src/watch.ts",
