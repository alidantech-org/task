{
  "name": "task",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": ["source/api", "source/apps/cli", "source/apps/local", "source/apps/site", "source/apps/tui", "source/packages/*"],
  "scripts": {
    "dev": "bun run --filter @task/cli dev",
    "dev:cli": "bun run --filter @task/cli dev",
    "dev:local": "concurrently -k \"bun run dev:local:runtime\" \"bun run dev:local:web\"",
    "dev:local:runtime": "bun run --filter @task/local dev:runtime",
    "dev:local:web": "bun run --filter @task/local dev:web",
    "dev:site": "bun run --filter @task/site dev",
    "dev:api": "bun run --filter @task/api dev",
    "dev:tui": "bun run --filter @task/tui dev",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0"
  }
}